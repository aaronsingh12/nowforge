{
  "setup": {
    "table": "incident",
    "payload": {
      "short_description": "Demo flow test incident",
      "impact": "1",
      "urgency": "1",
      "active": true
    }
  },
  "wait": {
    "flowName": "Demo Incident Priority Notification",
    "timeoutSec": 90
  },
  "assert": [
    {
      "table": "incident",
      "locate": {
        "bySetupRecord": true
      },
      "field": "assignment_group",
      "expect": {
        "display": "Service Desk"
      },
      "note": "assignment group set to Service Desk"
    },
    {
      "table": "incident",
      "locate": {
        "bySetupRecord": true
      },
      "field": "work_notes",
      "expect": {
        "value": "High-priority incident automatically routed by the Demo Incident Priority Notification flow.\nNotification sent to the incident caller."
      },
      "note": "work notes contain routing and notification messages"
    }
  ],
  "cleanup": [
    {
      "table": "incident",
      "locate": {
        "bySetupRecord": true
      }
    }
  ]
}