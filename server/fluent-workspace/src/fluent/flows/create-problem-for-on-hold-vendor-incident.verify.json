{
  "setup": {
    "table": "incident",
    "payload": {
      "short_description": "Test incident",
      "impact": "2",
      "urgency": "2"
    },
    "update": {
      "incident_state": "3",
      "hold_reason": "4",
      "impact": "1",
      "urgency": "1"
    }
  },
  "wait": {
    "flowName": "Create Problem for On Hold Vendor Incident",
    "timeoutSec": 90
  },
  "assert": [
    {
      "table": "problem",
      "locate": {
        "byQuery": "short_description=Vendor issue: Test incident"
      },
      "field": "short_description",
      "expect": {
        "value": "Vendor issue: Test incident"
      },
      "note": "verifies a problem record is created with the expected short description"
    },
    {
      "table": "incident",
      "locate": {
        "byQuery": "sys_id={{setup.sys_id}}^problem!=EMPTY"
      },
      "field": "problem",
      "expect": {
        "display": "not empty"
      },
      "note": "verifies the incident's Problem field was linked to the new problem"
    },
    {
      "table": "incident",
      "locate": {
        "bySetupRecord": true
      },
      "field": "work_notes",
      "expect": {
        "value": "Problem PRB* created"
      },
      "note": "verifies a work note was added containing the new problem's number"
    },
    {
      "table": "problem",
      "locate": {
        "byQuery": "short_description=Vendor issue: Test incident"
      },
      "field": "assigned_to",
      "expect": {
        "value": ""
      },
      "note": "verifies that for a Critical priority incident the problem's Assigned to is set to the Hardware group's (empty) manager"
    }
  ],
  "cleanup": [
    {
      "table": "incident",
      "locate": {
        "bySetupRecord": true
      }
    },
    {
      "table": "problem",
      "locate": {
        "byQuery": "short_description=Vendor issue: Test incident"
      }
    }
  ]
}