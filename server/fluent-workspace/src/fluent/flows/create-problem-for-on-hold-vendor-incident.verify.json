{
  "setup": {
    "table": "incident",
    "payload": {
      "short_description": "Printer not printing",
      "incident_state": "2",
      "hold_reason": "1"
    },
    "update": {
      "incident_state": "3",
      "hold_reason": "4",
      "impact": "1",
      "urgency": "1"
    }
  },
  "wait": {
    "flowName": "Create Problem for On Hold Vendor Incident",
    "timeoutSec": 90
  },
  "assert": [
    {
      "table": "problem",
      "locate": {
        "byQuery": "short_description=Vendor issue: Printer not printing"
      },
      "field": "short_description",
      "expect": {
        "value": "Vendor issue: Printer not printing"
      },
      "note": "creates a problem record with short description prefixed"
    },
    {
      "table": "incident",
      "locate": {
        "bySetupRecord": true
      },
      "field": "problem",
      "expect": {
        "display": "Vendor issue: Printer not printing"
      },
      "note": "sets the incident's Problem field to reference the new problem"
    },
    {
      "table": "incident",
      "locate": {
        "bySetupRecord": true
      },
      "field": "work_notes",
      "expect": {
        "value": "Problem "
      },
      "note": "adds a work note containing the new problem's number"
    },
    {
      "table": "problem",
      "locate": {
        "byQuery": "short_description=Vendor issue: Printer not printing"
      },
      "field": "assigned_to",
      "expect": {
        "value": ""
      },
      "note": "sets Assigned to manager of Hardware group when priority is Critical"
    }
  ],
  "cleanup": [
    {
      "table": "incident",
      "locate": {
        "bySetupRecord": true
      }
    },
    {
      "table": "problem",
      "locate": {
        "byQuery": "short_description=Vendor issue: Printer not printing"
      }
    }
  ]
}