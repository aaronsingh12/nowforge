{
  "setup": {
    "table": "incident",
    "payload": {
      "short_description": "Test incident"
    },
    "update": {
      "incident_state": "3",
      "hold_reason": "4",
      "impact": "1",
      "urgency": "1"
    }
  },
  "wait": {
    "flowName": "Create Problem for On Hold Vendor Incident",
    "timeoutSec": 90
  },
  "assert": [
    {
      "table": "problem",
      "locate": {
        "byQuery": "short_description=Vendor issue: Test incident"
      },
      "field": "short_description",
      "expect": {
        "value": "Vendor issue: Test incident"
      },
      "note": "Problem created with prefixed short description"
    },
    {
      "table": "incident",
      "locate": {
        "byQuery": "sys_id={{setup.sys_id}}^problemISNOTEMPTY"
      },
      "field": "short_description",
      "expect": {
        "value": "Test incident"
      },
      "note": "Incident's Problem field linked to newly created problem"
    },
    {
      "table": "incident",
      "locate": {
        "bySetupRecord": true
      },
      "field": "work_notes",
      "expect": {
        "value": "Problem "
      },
      "note": "Work note added with problem number"
    },
    {
      "table": "problem",
      "locate": {
        "byQuery": "short_description=Vendor issue: Test incident"
      },
      "field": "assigned_to",
      "expect": {
        "value": ""
      },
      "note": "Problem assigned_to set to hardware group's manager when priority critical (empty here due to missing group)"
    }
  ],
  "cleanup": [
    {
      "table": "incident",
      "locate": {
        "bySetupRecord": true
      }
    },
    {
      "table": "problem",
      "locate": {
        "byQuery": "short_description=Vendor issue: Test incident"
      }
    }
  ]
}