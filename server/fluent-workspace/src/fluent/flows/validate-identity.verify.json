{
  "kind": "subflow",
  "subflow": "Validate Identity",
  "setup": {
    "table": "sys_user",
    "payload": {
      "active": "true",
      "email": "vi_test_user@example.com",
      "user_name": "vi_test_user",
      "first_name": "Validate",
      "last_name": "Identity"
    }
  },
  "inputs": {
    "user": "{{setup.sys_id}}"
  },
  "wait": {
    "timeoutSec": 120
  },
  "assert": [],
  "expectOutputs": [
    {
      "name": "isValid",
      "expect": {
        "value": "true"
      },
      "note": "Subflow returns true when the supplied user is active and has a non‑empty email address"
    }
  ],
  "cleanup": [
    {
      "table": "sys_user",
      "locate": {
        "bySetupRecord": true
      }
    }
  ]
}