{
  "setup": {
    "table": "incident",
    "payload": {
      "short_description": "Test high priority incident",
      "impact": 1,
      "urgency": 1,
      "assignment_group": "a1b2c3d4e5f607890123456789abcdef"
    }
  },
  "wait": {
    "flowName": "Handle High Priority Incident",
    "timeoutSec": 90
  },
  "assert": [
    {
      "table": "incident",
      "locate": {
        "bySetupRecord": true
      },
      "field": "work_notes",
      "expect": {
        "value": "High priority incident processed automatically."
      },
      "note": "Flow added the expected work note for a high‑priority incident"
    },
    {
      "table": "incident",
      "locate": {
        "bySetupRecord": true
      },
      "field": "assigned_to",
      "expect": {
        "display": "John Doe"
      },
      "note": "Flow assigned the incident to the manager of the assignment group when assigned_to was empty"
    },
    {
      "table": "sys_email",
      "locate": {
        "byQuery": "reference={{setup.sys_id}}^recipientsLIKEjohn.doe@example.com"
      },
      "field": "subject",
      "expect": {
        "value": "High Priority Incident {{setup.number}}"
      },
      "note": "Flow sent an email to the assignment group manager notifying about the high‑priority incident"
    }
  ],
  "cleanup": [
    {
      "table": "incident",
      "locate": {
        "bySetupRecord": true
      }
    },
    {
      "table": "sys_email",
      "locate": {
        "byQuery": "reference={{setup.sys_id}}"
      }
    }
  ]
}