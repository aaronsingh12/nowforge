{
  "setup": {
    "table": "incident",
    "payload": {
      "short_description": "Test incident",
      "state": 2,
      "hold_reason": 1,
      "impact": 1,
      "urgency": 1
    },
    "update": {
      "state": 3,
      "hold_reason": 4
    }
  },
  "wait": {
    "flowName": "Create Problem for On Hold Vendor Incidents",
    "timeoutSec": 90
  },
  "assert": [
    {
      "table": "problem",
      "locate": {
        "byQuery": "assignment_group=8a5055c9c61122780043563ef53438e3^short_description=Vendor issue: Test incident"
      },
      "field": "short_description",
      "expect": {
        "value": "Vendor issue: Test incident"
      },
      "note": "sets the problem short description prefixed with \"Vendor issue: \""
    },
    {
      "table": "problem",
      "locate": {
        "byQuery": "assignment_group=8a5055c9c61122780043563ef53438e3^short_description=Vendor issue: Test incident"
      },
      "field": "assignment_group",
      "expect": {
        "display": "Hardware"
      },
      "note": "assigns the problem to the Hardware group"
    },
    {
      "table": "incident",
      "locate": {
        "bySetupRecord": true
      },
      "field": "work_notes",
      "expect": {
        "value": "Linked Problem"
      },
      "note": "adds a work note to the incident containing the problem number"
    }
  ],
  "cleanup": [
    {
      "table": "incident",
      "locate": {
        "bySetupRecord": true
      }
    },
    {
      "table": "problem",
      "locate": {
        "byQuery": "assignment_group=8a5055c9c61122780043563ef53438e3^short_description=Vendor issue: Test incident"
      }
    }
  ],
  "unverifiable": [
    {
      "effect": "link the new problem back to the incident",
      "kind": "field_absent",
      "table": "incident",
      "field": "problem",
      "note": "The 'problem' field does not exist on this instance, so the link cannot be stored."
    },
    {
      "effect": "assign the problem to the Hardware group manager when incident priority is Critical",
      "kind": "source_empty",
      "table": "sys_user_group",
      "field": "manager",
      "sys_id": "8a5055c9c61122780043563ef53438e3",
      "note": "The manager field on the Hardware group is empty on this instance, so no manager can be assigned."
    }
  ]
}