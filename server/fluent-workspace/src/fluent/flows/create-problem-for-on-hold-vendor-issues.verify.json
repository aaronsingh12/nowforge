{
  "setup": {
    "table": "incident",
    "payload": {
      "short_description": "Test incident",
      "impact": "1",
      "urgency": "1"
    },
    "update": {
      "state": "3",
      "hold_reason": "4"
    }
  },
  "wait": {
    "flowName": "Create Problem for On Hold Vendor Issues",
    "timeoutSec": 90
  },
  "assert": [
    {
      "table": "problem",
      "locate": {
        "byQuery": "short_description=Vendor issue: Test incident"
      },
      "field": "short_description",
      "expect": {
        "value": "Vendor issue: Test incident"
      },
      "note": "creates a new problem record with prefixed short description"
    },
    {
      "table": "incident",
      "locate": {
        "byQuery": "sys_id={{setup.sys_id}}^problemISNOTEMPTY"
      },
      "field": "short_description",
      "expect": {
        "value": "Test incident"
      },
      "note": "incident's Problem field linked to the new problem"
    },
    {
      "table": "incident",
      "locate": {
        "byQuery": "sys_id={{setup.sys_id}}^work_notesISNOTEMPTY"
      },
      "field": "short_description",
      "expect": {
        "value": "Test incident"
      },
      "note": "adds a work note containing the new problem's number"
    },
    {
      "table": "problem",
      "locate": {
        "byQuery": "short_description=Vendor issue: Test incident^assigned_toISEMPTY"
      },
      "field": "short_description",
      "expect": {
        "value": "Vendor issue: Test incident"
      },
      "note": "sets problem's Assigned to to Hardware manager when priority is Critical (empty manager results in empty assigned_to)"
    }
  ],
  "cleanup": [
    {
      "table": "incident",
      "locate": {
        "bySetupRecord": true
      }
    },
    {
      "table": "problem",
      "locate": {
        "byQuery": "short_description=Vendor issue: Test incident"
      }
    }
  ]
}