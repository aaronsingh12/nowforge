{
  "setup": {
    "table": "sc_req_item",
    "payload": {
      "short_description": "Test leave request",
      "requested_for": "6816f79cc0a8016401c5a33be04be441"
    }
  },
  "wait": {
    "flowName": "Request Manager and HR Approval for Leave Requests",
    "timeoutSec": 90
  },
  "assert": [
    {
      "table": "sysapproval_approver",
      "locate": {
        "byQuery": "document_id={{setup.sys_id}}^approverISNOTEMPTY"
      },
      "field": "state",
      "expect": {
        "display": "requested"
      },
      "note": "manager approval task created"
    },
    {
      "table": "sysapproval_approver",
      "locate": {
        "byQuery": "document_id={{setup.sys_id}}^group=d625dccec0a8016700a222a0f7900d06"
      },
      "field": "state",
      "expect": {
        "display": "requested"
      },
      "note": "HR approval task created for Service Desk group"
    }
  ],
  "resume": {
    "table": "sysapproval_approver",
    "locate": {
      "byQuery": "document_id={{setup.sys_id}}"
    },
    "patch": {
      "state": "approved"
    },
    "waitSec": 90,
    "note": "approve manager and HR approvals so the flow continues"
  },
  "assertAfterResume": [
    {
      "table": "sc_req_item",
      "locate": {
        "bySetupRecord": true
      },
      "field": "work_notes",
      "expect": {
        "display": "Your leave request has been processed and approved."
      },
      "note": "confirmation note added after HR approval"
    }
  ],
  "cleanup": [
    {
      "table": "sc_req_item",
      "locate": {
        "bySetupRecord": true
      }
    },
    {
      "table": "sysapproval_approver",
      "locate": {
        "byQuery": "document_id={{setup.sys_id}}"
      }
    }
  ]
}